{
  "name": "@tacxou/jsonforms_builder",
  "version": "2.0.0",
  "description": "JSONForms renderers for Vue 3 built on Nuxt UI & Tailwind CSS",
  "repository": "https://github.com/tacxou/jsonforms_builder.git",
  "author": "tacxou <12997062+tacxou@users.noreply.github.com> (https://github.com/tacxou)",
  "contributors": [
    {
      "name": " tacxou",
      "email": "12997062+tacxou@users.noreply.github.com",
      "url": "https://github.com/tacxou"
    },
    {
      "name": "Contributors",
      "url": "https://github.com/tacxou/jsonforms_builder/graphs/contributors"
    }
  ],
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/json-formbuilder.cjs.js",
  "module": "./dist/json-formbuilder.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/json-formbuilder.es.js",
      "require": "./dist/json-formbuilder.cjs.js"
    },
    "./source": "./src/index.ts"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "bunx vite build --config vite.config.ts",
    "postbuild": "cpr README.md dist/README.md && cpr LICENSE dist/LICENSE && cpr package.json dist/package.json",
    "start:dev": "cd playground && bunx vite --host",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage:renderers": "bun run build && bun run playground/examples/coverage.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "defu": "^6.1.4",
    "radash": "^12.1.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@jsonforms/core": "^3.6.0",
    "@jsonforms/vue": "^3.6.0",
    "@nuxt/ui": "^4.8.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "dayjs": "^1.11.13",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/language-plugin-pug": "^3.0.5",
    "@vueuse/core": "^14.3.0",
    "cpr": "^3.0.1",
    "eslint": "^9.32.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-pug": "^0.4.1",
    "vue": "^3.5.1",
    "vue-router": "^4.5.0"
  },
  "peerDependencies": {
    "@jsonforms/core": "^3.6",
    "@jsonforms/vue": "^3.6",
    "@nuxt/ui": "^4.8",
    "typescript": "^5",
    "vue": "^3.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.0.0"
}
