{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "**",
      // Generated by Nuxt UI's Vite plugin.
      "!playground/auto-imports.d.ts",
      "!playground/components.d.ts",
      // Standalone Tiptap converter playground, unrelated to the library code:
      // reformatting it would add nothing.
      "!tests/prosemirror.html",
      // Dépôts de référence locaux (non versionnés) : leur propre biome.json est vu
      // comme une configuration racine imbriquée et fait échouer `yarn lint`.
      "!samples",
      // MCP package keeps its own yarn.lock / node_modules tree.
      "!mcp/node_modules",
      "!mcp/dist",
      "!mcp/yarn.lock"
    ]
  },

  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // The `.prettierrc` `printWidth: 180` did not match the repo: code wraps around
    // 95–100 columns, and 100 is where the measured gap is smallest. Prettier never
    // actually ran here — no script invoked it.
    "lineWidth": 100,
    "lineEnding": "lf"
  },

  "css": {
    "parser": {
      // Tailwind 4 drives its config from CSS: `@source`, `@theme`, `@variant`
      // are not standard CSS and fail the default parser.
      "tailwindDirectives": true
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "suspicious": {
        // The v2 stack still has 159 `any`s: warn without blocking `yarn lint`
        // until they are worked down.
        "noExplicitAny": "warn",
        // `then` is a JSON Schema keyword (`if`/`then`/`else`) ubiquitous in example
        // schemas; the rule targets *thenable* objects, not that case.
        "noThenProperty": "off"
      },

      "style": {
        // Renderers are named after the JSON Schema construct they handle
        // (`object.vue`, `one-of.vue`…): the convention is intentional.
        "useVueMultiWordComponentNames": "off"
      }
    }
  },

  "assist": {
    "actions": {
      "source": {
        // Left off on purpose: turning it on would reorder imports across the whole
        // repo at once. Flip to `"on"` during a dedicated pass.
        "organizeImports": "off"
      }
    }
  },

  "overrides": [
    {
      // In a test, `!` asserts a value the test itself guarantees is present —
      // rewriting it as optional access would hide failures instead of surfacing them.
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      // Biome only analyzes an SFC's `<script>` block, never the `<template>` —
      // especially with Pug. Any binding used only by the template would look unused,
      // so these two rules are only useful outside `.vue` files.
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
