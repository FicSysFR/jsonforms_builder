{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "**",
      // Générés par le plugin Vite de Nuxt UI.
      "!playground/auto-imports.d.ts",
      "!playground/components.d.ts",
      // Outil autonome de mise au point du convertisseur Tiptap, sans rapport avec le
      // code de la librairie : le reformater n'apporterait rien.
      "!tests/prosemirror.html"
    ]
  },

  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Le `printWidth: 180` de `.prettierrc` ne décrivait pas le dépôt : le code est
    // enroulé autour de 95-100 colonnes, et c'est à 100 que l'écart mesuré est le plus
    // faible. Prettier n'a d'ailleurs jamais tourné ici — aucun script ne l'appelait.
    "lineWidth": 100,
    "lineEnding": "lf"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      "suspicious": {
        // Le socle v2 compte encore 159 `any` : les signaler sans bloquer `yarn lint`,
        // le temps de les résorber.
        "noExplicitAny": "warn",
        // `then` est un mot-clé JSON Schema (`if`/`then`/`else`) omniprésent dans les
        // schémas d'exemple ; la règle vise les objets *thenables*, pas ce cas.
        "noThenProperty": "off"
      },

      "style": {
        // Les renderers sont nommés d'après la construction JSON Schema qu'ils prennent
        // en charge (`object.vue`, `one-of.vue`…) : la convention est délibérée.
        "useVueMultiWordComponentNames": "off"
      }
    }
  },

  "assist": {
    "actions": {
      "source": {
        // Laissé inactif volontairement : l'activer réordonnerait les imports de tout le
        // dépôt d'un coup. À basculer sur `"on"` lors d'une passe dédiée.
        "organizeImports": "off"
      }
    }
  },

  "overrides": [
    {
      // Biome n'analyse que le bloc `<script>` d'un SFC, jamais le `<template>` — a
      // fortiori en Pug. Toute liaison consommée uniquement par le template y passerait
      // donc pour inutilisée : ces deux règles ne sont exploitables que hors `.vue`.
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
