{
  "compilerOptions": {
    "module": "es2022",
    "types": ["node"],
    // `DOM` is required: the library uses drag-and-drop events, `fetch`,
    // `AbortController`, and `structuredClone`. v1 declared `["es7"]` alone, which
    // left declaration generation without those types.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "noLib": false,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
