{
  "compilerOptions": {
    "module": "es2022",
    "types": ["node"],
    // `DOM` est indispensable : la librairie manipule des événements de glisser-déposer,
    // `fetch`, `AbortController` et `structuredClone`. La v1 déclarait `["es7"]` seul, ce
    // qui privait la génération de déclarations de tous ces types.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "noLib": false,
    "incremental": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
